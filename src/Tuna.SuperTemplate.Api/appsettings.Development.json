{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RedisServerSettings": {
    "ConnectionString": "localhost:6379",
    "AbortOnConnectFail": false,
    "AsyncTimeoutMilliSecond": 60000,
    "ConnectTimeoutMilliSecond": 15000,
    "Password": "redis123",
    "AllowAdmin": true
  },
  "CacheSettings": {
    "Type": 2,
    "MemExpiryTime": "00:00:10",
    "RedisExpiryTime": "00:10:00"
  },
  "Resilience": {
    "RetryCount": 3,
    "RetryDelayMs": 2000,
    "CircuitBreakerFailures": 5,
    "CircuitBreakerDurationSec": 30,
    "TimeoutSec": 10,
    "MaxParallelization": 10,
    "MaxQueuingActions": 20
  },
  "RateLimitOptions": {
    "Limit": 5,
    "PeriodInMs": 1000,
    "QueueLimit": 0
  },

  "CorsOptions": {
    "AllowedOrigins": []
  },
  "Jwt": {
    "Issuer": "TunaSuperTemplate",
    "Audience": "TunaSuperTemplate",
    "SecretKey": "tuna-super-template-secret-key",
    "ExpirationMinutes": 120
  },
  "Encryption": {
    "Key": "tunasupertemplate-encrypton-key"
  },
  "AllowedHosts": "*"
}
